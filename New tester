--═══════════════════════════════════════════════════════════════════
-- KEYBIND SYSTEM
--═══════════════════════════════════════════════════════════════════
KeybindData = { Conns = {}, States = {} }

function ParseKey(name)
  if not name or name == "" then return nil end
  local clean = tostring(name):gsub("%s+", "")
  if clean == "" then return nil end
  local aliases = {
    SHIFT="LeftShift", LSHIFT="LeftShift", RSHIFT="RightShift",
    CTRL="LeftControl", CONTROL="LeftControl", LCTRL="LeftControl", RCTRL="RightControl",
    ALT="LeftAlt", LALT="LeftAlt", RALT="RightAlt",
    ESC="Escape", ESCAPE="Escape", ENTER="Return", RETURN="Return",
    SPACE="Space", BACKSPACE="Backspace", TAB="Tab", CAPSLOCK="CapsLock",
    UP="Up", DOWN="Down", LEFT="Left", RIGHT="Right",
    DEL="Delete", DELETE="Delete", INS="Insert", INSERT="Insert",
    HOME="Home", END="End", PAGEUP="PageUp", PAGEDOWN="PageDown",
  }
  local up = clean:upper()
  if aliases[up] then
    local ok, e = pcall(function() return Enum.KeyCode[aliases[up]] end)
    if ok and e then return e end
  end
  local ok1, e1 = pcall(function() return Enum.KeyCode[clean] end)
  if ok1 and e1 then return e1 end
  local ok2, e2 = pcall(function() return Enum.KeyCode[up] end)
  if ok2 and e2 then return e2 end
  local capped = clean:sub(1,1):upper() .. clean:sub(2):lower()
  local ok3, e3 = pcall(function() return Enum.KeyCode[capped] end)
  if ok3 and e3 then return e3 end
  return nil
end

function RegisterKeybind(id, keyName, callback)
  if KeybindData.Conns[id] then
    pcall(function() KeybindData.Conns[id]:Disconnect() end)
    KeybindData.Conns[id] = nil
  end
  if not keyName or keyName == "" then return end
  local keyEnum = ParseKey(keyName)
  if not keyEnum then return end
  KeybindData.Conns[id] = userInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == keyEnum then
      if callback then pcall(callback) end
    end
  end)
end

function ToggleWithKeybind(tab, opts)
  local name = opts.Name
  local default = opts.CurrentValue or false
  local callback = opts.Callback
  local flag = opts.Flag
  local defaultKey = opts.DefaultKeybind or ""
  local id = opts.KeybindId or (name .. "_" .. tostring(math.random(100000, 999999)))

  KeybindData.States[id] = default

  local function fire(v)
    KeybindData.States[id] = v
    if callback then pcall(callback, v) end
  end

  local toggle = tab:CreateToggle({
    Name = name,
    CurrentValue = default,
    Flag = flag,
    Callback = function(v)
      KeybindData.States[id] = v
      if callback then pcall(callback, v) end
    end,
  })

  tab:CreateInput({
    Name = "↳ Keybind: " .. name,
    PlaceholderText = "key (Q, Shift...) blank=none",
    CurrentValue = defaultKey,
    RemoveTextAfterFocusLost = true,
    Flag = (flag or id) .. "_kb",
    Callback = function(text)
      RegisterKeybind(id, text, function()
        local newVal = not KeybindData.States[id]
        pcall(function() toggle:Set(newVal) end)
        fire(newVal)
      end)
    end,
  })

  if defaultKey ~= "" then
    RegisterKeybind(id, defaultKey, function()
      local newVal = not KeybindData.States[id]
      pcall(function() toggle:Set(newVal) end)
      fire(newVal)
    end)
  end
  return toggle
end

function ButtonWithKeybind(tab, opts)
  local name = opts.Name
  local callback = opts.Callback
  local id = name .. "_btn_" .. tostring(math.random(10000, 99999))
  
  tab:CreateButton({ Name = name, Callback = callback })
  tab:CreateInput({
    Name = "↳ Keybind: " .. name,
    PlaceholderText = "key (Q, Shift...) blank=none",
    CurrentValue = "",
    RemoveTextAfterFocusLost = true,
    Callback = function(text) RegisterKeybind(id, text, callback) end,
  })
end

