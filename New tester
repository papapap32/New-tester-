    box.CanCollide = false
    box.Material = Enum.Material.ForceField
    box.Color = Color3.fromRGB(220, 50, 50)
    box.Transparency = 0.7
    box.Parent = hrp
  end
  box.Size = Vector3.new(CONFIG.ShieldSize * 2, CONFIG.ShieldSize * 2, CONFIG.ShieldSize * 2)
  box.CFrame = hrp.CFrame
  if isPushing then return end
  for _, p in ipairs(players:GetPlayers()) do
    if p ~= localPlayer and p.Character and not isSafePlayer(p) then
      local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
      local tHum = p.Character:FindFirstChildOfClass("Humanoid")
      if tHRP and tHum and tHum.Health > 0 and (tHRP.Position - hrp.Position).Magnitude <= CONFIG.ShieldSize then
        isPushing = true
        local pushPos = hrp.Position + (hrp.CFrame.LookVector * (CONFIG.ShieldSize + CONFIG.ShieldPushDistance))
        task.spawn(function() performBringOne(p, pushPos); isPushing = false end)
        break
      end
    end
  end
end)

